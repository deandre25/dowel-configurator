// Connection strings live in prisma.config.ts and in the client factory, not
// here: Prisma 7 removed `url`/`directUrl` from the schema datasource.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

enum Finish {
  OAK
  CHARCOAL
  WHITE
}

/// A saved build, addressed by a short id that becomes the share link.
///
/// `modules` holds the placed modules as written by the server; it is
/// re-validated on read, because a row could have been edited by hand.
///
/// `hash` is the SHA-256 of the configuration's canonical form, and it is
/// unique: saving the same build twice returns the row that is already there
/// rather than writing another one. That makes a save idempotent, gives the
/// same build the same share link, and bounds the table to distinct
/// configurations — this is a public, unauthenticated write against a 0.5 GB
/// free tier.
model Configuration {
  id        String   @id
  hash      String   @unique
  width     Int
  height    Int
  finish    Finish
  modules   Json
  createdAt DateTime @default(now())
}
