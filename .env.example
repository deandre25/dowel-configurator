# Pooled Neon connection. Every request the app serves goes through this one,
# because the app runs in serverless functions. The host contains "-pooler".
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Direct Neon connection, used only by `prisma migrate`. The pooler cannot
# carry migrations.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full"
